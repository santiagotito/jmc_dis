	column '11. Fact' = ```
			
			VAR FacturaBase = 
			    SWITCH(
			        TRUE(),
			        NOT(ISBLANK('B1. MAYORES 2019 - 2023'[FACTURA])), 'B1. MAYORES 2019 - 2023'[FACTURA],
			        'B1. MAYORES 2019 - 2023'[8. TIPO FACTURA] = "SALDOS INICIALES", "SALDOS INICIALES",
			        "OTROS"
			    )
			VAR FacturaFinal = 
			    IF(
			        FIND("-", FacturaBase, 1, 0) > 0,
			        RIGHT(FacturaBase, LEN(FacturaBase) - FIND("-", FacturaBase)),
			        FacturaBase
			    )
			RETURN
			    FacturaFinal
			```
