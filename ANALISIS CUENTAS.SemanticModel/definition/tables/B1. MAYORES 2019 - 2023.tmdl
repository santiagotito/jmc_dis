table 'B1. MAYORES 2019 - 2023'
	lineageTag: a9b2845a-b920-4306-8345-d347fdbe300f

	measure '1. Facturas Únicas' = DISTINCTCOUNT('B1. MAYORES 2019 - 2023'[5. Factura])
		formatString: #,0
		displayFolder: 1. MEDIDAS
		lineageTag: c7801975-bbdd-462b-b576-7823b3a2fbb2

	measure 'PROMO_Total Gasto' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[DEBE]),
			'B1. MAYORES 2019 - 2023'[7. cuentas promocion] <> "otros"
		)
		formatString: \$#,0.00
		displayFolder: 2. PROMOCION Y PUBLICIDAD
		lineageTag: promo-001-total-gasto

	measure 'PROMO_Asientos Únicos' =
		CALCULATE(
			DISTINCTCOUNT('B1. MAYORES 2019 - 2023'[ID_ASIENTO]),
			'B1. MAYORES 2019 - 2023'[7. cuentas promocion] <> "otros"
		)
		formatString: #,0
		displayFolder: 2. PROMOCION Y PUBLICIDAD
		lineageTag: promo-002-asientos

	measure 'PROMO_Clientes Beneficiados' =
		CALCULATE(
			DISTINCTCOUNT('B1. MAYORES 2019 - 2023'[CLIENTE_PROMOCION]),
			'B1. MAYORES 2019 - 2023'[CLIENTE_PROMOCION] <> ""
		)
		formatString: #,0
		displayFolder: 2. PROMOCION Y PUBLICIDAD
		lineageTag: promo-003-clientes

	measure 'PROMO_Promedio por Asiento' =
		DIVIDE([PROMO_Total Gasto], [PROMO_Asientos Únicos], 0)
		formatString: \$#,0.00
		displayFolder: 2. PROMOCION Y PUBLICIDAD
		lineageTag: promo-004-promedio

	measure 'PROMO_% vs Total Gastos' =
		VAR TotalPromo = [PROMO_Total Gasto]
		VAR TotalGastos = CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[DEBE]),
			LEFT('B1. MAYORES 2019 - 2023'[CUENTA], 1) = "5"
		)
		RETURN DIVIDE(TotalPromo, TotalGastos, 0)
		formatString: 0.00%
		displayFolder: 2. PROMOCION Y PUBLICIDAD
		lineageTag: promo-005-porcentaje

	measure 'PROMO_Registros Sospechosos' =
		CALCULATE(
			COUNTROWS('B1. MAYORES 2019 - 2023'),
			'B1. MAYORES 2019 - 2023'[7. cuentas promocion] <> "otros",
			OR(
				'B1. MAYORES 2019 - 2023'[CONTRAPARTIDA_TIPO] = "",
				'B1. MAYORES 2019 - 2023'[CONTRAPARTIDA_TIPO] = "OTRA"
			)
		)
		formatString: #,0
		displayFolder: 2. PROMOCION Y PUBLICIDAD
		lineageTag: promo-006-sospechosos

	measure 'CXP_Total Debe' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[DEBE]),
			'B1. MAYORES 2019 - 2023'[ES_CXP] = TRUE()
		)
		formatString: \$#,0.00
		displayFolder: 3. CUENTAS POR PAGAR
		lineageTag: cxp-001-debe

	measure 'CXP_Total Haber' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[HABER]),
			'B1. MAYORES 2019 - 2023'[ES_CXP] = TRUE()
		)
		formatString: \$#,0.00
		displayFolder: 3. CUENTAS POR PAGAR
		lineageTag: cxp-002-haber

	measure 'CXP_Saldo Pendiente' =
		[CXP_Total Haber] - [CXP_Total Debe]
		formatString: \$#,0.00
		displayFolder: 3. CUENTAS POR PAGAR
		lineageTag: cxp-003-saldo

	measure 'CXP_Proveedores Únicos' =
		CALCULATE(
			DISTINCTCOUNT('B1. MAYORES 2019 - 2023'[PROVEEDOR]),
			'B1. MAYORES 2019 - 2023'[ES_CXP] = TRUE()
		)
		formatString: #,0
		displayFolder: 3. CUENTAS POR PAGAR
		lineageTag: cxp-004-proveedores

	measure 'CXP_Pagos por Cheque' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[DEBE]),
			'B1. MAYORES 2019 - 2023'[ES_CXP] = TRUE(),
			'B1. MAYORES 2019 - 2023'[FORMA_PAGO] = "CHEQUE"
		)
		formatString: \$#,0.00
		displayFolder: 3. CUENTAS POR PAGAR
		lineageTag: cxp-005-cheque

	measure 'CXP_Pagos por Transferencia' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[DEBE]),
			'B1. MAYORES 2019 - 2023'[ES_CXP] = TRUE(),
			'B1. MAYORES 2019 - 2023'[FORMA_PAGO] = "TRANSFERENCIA"
		)
		formatString: \$#,0.00
		displayFolder: 3. CUENTAS POR PAGAR
		lineageTag: cxp-006-transferencia

	measure 'CXP_Pagos por NC' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[DEBE]),
			'B1. MAYORES 2019 - 2023'[ES_CXP] = TRUE(),
			'B1. MAYORES 2019 - 2023'[FORMA_PAGO] = "NOTA_CREDITO"
		)
		formatString: \$#,0.00
		displayFolder: 3. CUENTAS POR PAGAR
		lineageTag: cxp-007-nc

	measure 'CXP_Registros' =
		CALCULATE(
			COUNTROWS('B1. MAYORES 2019 - 2023'),
			'B1. MAYORES 2019 - 2023'[ES_CXP] = TRUE()
		)
		formatString: #,0
		displayFolder: 3. CUENTAS POR PAGAR
		lineageTag: cxp-008-registros

	measure 'CXC_Total Facturado' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[DEBE]),
			'B1. MAYORES 2019 - 2023'[ES_CXC] = TRUE(),
			'B1. MAYORES 2019 - 2023'[TIPO_DOCUMENTO] = "FACTURA"
		)
		formatString: \$#,0.00
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-001-facturado

	measure 'CXC_Total Cobrado' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[HABER]),
			'B1. MAYORES 2019 - 2023'[ES_CXC] = TRUE()
		)
		formatString: \$#,0.00
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-002-cobrado

	measure 'CXC_Saldo Cartera' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[DEBE]) - SUM('B1. MAYORES 2019 - 2023'[HABER]),
			'B1. MAYORES 2019 - 2023'[ES_CXC] = TRUE()
		)
		formatString: \$#,0.00
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-003-cartera

	measure 'CXC_Clientes Únicos' =
		CALCULATE(
			DISTINCTCOUNT('B1. MAYORES 2019 - 2023'[CLIENTE]),
			'B1. MAYORES 2019 - 2023'[ES_CXC] = TRUE()
		)
		formatString: #,0
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-004-clientes

	measure 'CXC_Facturas Únicas' =
		CALCULATE(
			DISTINCTCOUNT('B1. MAYORES 2019 - 2023'[FACTURA]),
			'B1. MAYORES 2019 - 2023'[ES_CXC] = TRUE(),
			'B1. MAYORES 2019 - 2023'[FACTURA] <> ""
		)
		formatString: #,0
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-005-facturas

	measure 'CXC_Recaudos' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[HABER]),
			'B1. MAYORES 2019 - 2023'[ES_CXC] = TRUE(),
			'B1. MAYORES 2019 - 2023'[TIPO_DOCUMENTO] = "RECAUDO"
		)
		formatString: \$#,0.00
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-006-recaudos

	measure 'CXC_Notas Crédito' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[HABER]),
			'B1. MAYORES 2019 - 2023'[ES_CXC] = TRUE(),
			'B1. MAYORES 2019 - 2023'[TIPO_DOCUMENTO] = "NOTA DE CREDITO"
		)
		formatString: \$#,0.00
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-007-nc

	measure 'CXC_Devoluciones' =
		CALCULATE(
			SUM('B1. MAYORES 2019 - 2023'[HABER]),
			'B1. MAYORES 2019 - 2023'[ES_CXC] = TRUE(),
			'B1. MAYORES 2019 - 2023'[TIPO_DOCUMENTO] = "DEVOLUCIÓN"
		)
		formatString: \$#,0.00
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-008-devoluciones

	measure 'CXC_% Recuperación' =
		DIVIDE([CXC_Total Cobrado], [CXC_Total Facturado], 0)
		formatString: 0.00%
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-009-recuperacion

	measure 'CXC_Ticket Promedio' =
		DIVIDE([CXC_Total Facturado], [CXC_Facturas Únicas], 0)
		formatString: \$#,0.00
		displayFolder: 4. CUENTAS POR COBRAR
		lineageTag: cxc-010-ticket

