	partition 'R1. Tabla de Fechas' = calculated
		mode: import
		source =
				
				VAR MinFechaBase = CALCULATE(MIN('B1. MAYORES 2019 - 2023'[FECHA]), ALL('B1. MAYORES 2019 - 2023'))
				VAR FechaActual = TODAY()
				RETURN
				    CALENDAR(MinFechaBase, FechaActual)

	annotation PBI_Id = e58f18786651443ab184e154574bc26a

